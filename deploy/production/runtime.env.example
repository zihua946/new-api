# Create runtime.env on the server with mode 0600. Never commit real values.
SQL_DSN=<dedicated-database-DSN>
REDIS_CONN_STRING=redis://redis:6379/0
SESSION_SECRET=<generate-on-server>
CRYPTO_SECRET=<generate-on-server>

# MCP business settings and trusted apps are managed in the dashboard.
MCP_ENABLED=false
MCP_ENCRYPTION_KEY=
MCP_ALLOWED_CLIENT_ORIGINS=
